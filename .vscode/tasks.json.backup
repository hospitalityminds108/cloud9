{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Resolve workspace conflicts",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\resolve_workspace_conflicts.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Clean page encoding",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\cleanup_html_backticks.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}